{
  "name": "urbanist-frontend",
  "description": "Shared frontend template for urbanist chapter sites",
  "author": "Thomas LaCroix",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:tokens && astro dev",
    "build": "npm run build:tokens && astro build",
    "preview": "astro preview",
    "clean": "rm -rf dist .astro",
    "generate:css": "tcm -p 'src/**/*.module.css' .",
    "build:viz-tiles": "echo 'no viz tiles yet'",
    "build:viz-poster": "echo 'no viz posters yet'",
    "capture:placeholders": "node scripts/capture-placeholders.js",
    "build:tokens": "node scripts/build-tokens.js",
    "lint:css": "stylelint 'src/**/*.css'"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@deck.gl/core": "^9.3.0",
    "@deck.gl/layers": "^9.3.0",
    "@deck.gl/mapbox": "^9.3.0",
    "@observablehq/plot": "^0.6.17",
    "astro": "^7.4.5",
    "d3-scale": "^4.0.2",
    "downshift": "^9.4.0",
    "graphql-request": "^7.4.0",
    "maplibre-gl": "^5.0.0",
    "pmtiles": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@lacrx/design-system": "file:../design-system",
    "@types/d3-scale": "^4.0.9",
    "better-sqlite3": "^12.9.0",
    "geojson-vt": "^4.0.2",
    "isomorphic-dompurify": "^3.8.0",
    "marked": "^18.0.0",
    "puppeteer": "^24.42.0",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5.9.3",
    "vt-pbf": "^3.1.3"
  }
}
