{
  "bg": {
    "$type": "color",
    "primary":   { "$value": "{color.neutral.0}", "$description": "Page background (white)" }
  },
  "text": {
    "$type": "color",
    "primary":   { "$value": "{color.neutral.900}", "$description": "Body text (near-black)" },
    "secondary": { "$value": "{color.neutral.700}", "$description": "Secondary text" },
    "muted":     { "$value": "{color.neutral.500}", "$description": "Captions, placeholders" }
  },
  "accent": {
    "$type": "color",
    "primary":   { "$value": "{color.neutral.900}", "$description": "Buttons, links (monochrome)" }
  },
  "btn": {
    "$type": "color",
    "text":      { "$value": "{color.neutral.0}", "$description": "Button label on dark bg" }
  },
  "border": {
    "$type": "color",
    "default":   { "$value": "{color.neutral.200}", "$description": "Rules, dividers" }
  },
  "font": {
    "display":   { "$value": "{font.serif}", "$description": "Headlines, article titles" },
    "body":      { "$value": "{font.sans}", "$description": "Body text, UI elements" }
  },
  "dash": {
    "$type": "color",
    "$description": "Dashboard semantic colors for data visualization",
    "accent":    { "$value": "{color.dash.accent}", "$description": "Primary chart color, interactive" },
    "positive":  { "$value": "{color.dash.positive}", "$description": "Good/increase indicators" },
    "negative":  { "$value": "{color.dash.negative}", "$description": "Bad/decrease indicators" },
    "neutral":   { "$value": "{color.dash.neutral}", "$description": "Inactive, baseline" },
    "surface":   { "$value": "{color.dash.surface}", "$description": "Dashboard card backgrounds" }
  }
}
