{
  "color": {
    "$type": "color",
    "dash": {
      "$description": "Dashboard data visualization palette",
      "accent":   { "$value": "#2563EB" },
      "positive": { "$value": "#16A34A" },
      "negative": { "$value": "#DC2626" },
      "neutral":  { "$value": "#9CA3AF" },
      "surface":  { "$value": "#F9FAFB" }
    },
    "severity": {
      "$description": "Walk audit severity scale",
      "safe":     { "$value": "#2A8A6A" },
      "caution":  { "$value": "#B07820" },
      "danger":   { "$value": "#C44020" },
      "connected":{ "$value": "#3DB893" }
    },
    "status": {
      "$description": "UI status colors",
      "error":         { "$value": "#CC0000" },
      "error-surface": { "$value": "#FEF3F2" },
      "error-border":  { "$value": "#FECACA" },
      "error-text":    { "$value": "#991B1B" },
      "warning":       { "$value": "#E8A020" }
    },
    "neutral": {
      "0":   { "$value": "#FFFFFF", "$description": "White" },
      "100": { "$value": "#F3F4F6", "$description": "Surface hover" },
      "200": { "$value": "#E2E2E2", "$description": "Light gray border" },
      "500": { "$value": "#767676", "$description": "Muted text" },
      "700": { "$value": "#333333", "$description": "Secondary text" },
      "900": { "$value": "#121212", "$description": "Near-black" }
    }
  },
  "space": {
    "$type": "dimension",
    "xs":  { "$value": "4px" },
    "sm":  { "$value": "8px" },
    "md":  { "$value": "16px" },
    "lg":  { "$value": "24px" },
    "xl":  { "$value": "32px" },
    "2xl": { "$value": "48px" },
    "3xl": { "$value": "64px" }
  },
  "fontSize": {
    "$type": "dimension",
    "sm":   { "$value": "0.875rem" },
    "base": { "$value": "1rem" },
    "lg":   { "$value": "1.25rem" },
    "xl":   { "$value": "1.5rem" },
    "2xl":  { "$value": "2rem" },
    "3xl":  { "$value": "2.5rem" }
  },
  "font": {
    "$type": "fontFamily",
    "serif": { "$value": "Georgia, 'Times New Roman', Times, serif" },
    "sans": { "$value": "Helvetica, 'Helvetica Neue', Arial, sans-serif" },
    "mono": { "$value": "'SF Mono', 'Cascadia Code', ui-monospace, monospace" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" }
  }
}
