{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/site/*": ["./sites/ncyimby/*"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules", "**/*.spec.tsx", "**/*.spec.ts"],
  "include": [
    "./src/**/*",
    "./sites/**/*",
    "./gatsby-config.ts",
    "./gatsby-node.ts"
  ]
}
