{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@/site/*": ["./sites/ncyimby/*"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules", "**/*.spec.tsx", "**/*.spec.ts"],
  "include": [
    "./src/**/*",
    "./sites/**/*",
    "./astro.config.ts"
  ]
}
