# Which site to build: ncyimby | stoside
SITE=ncyimby

# Strapi CMS (server-side, used during build for GraphQL queries)
STRAPI_URL=http://localhost:1337

# Strapi CMS (client-side, used for runtime API calls)
GATSBY_STRAPI_URL=http://localhost:1337

# Supabase (stoside auth)
GATSBY_SUPABASE_URL=
GATSBY_SUPABASE_KEY=
