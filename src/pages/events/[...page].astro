---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero/Hero.astro";
import Content from "@/components/Content/Content.astro";
import EventCard from "@/components/EventList/EventCard.astro";
import config from "@/site/config";
import { fetchEvents } from "@/lib/strapi";

export const getStaticPaths = (async ({ paginate }) => {
  const events = await fetchEvents(config);
  return paginate(events, { pageSize: 5 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout title="Events">
  <Hero title="Upcoming events" />
  <Content type="section" ruled>
    {page.data.length === 0 ? (
      <p>No upcoming events. Check back soon.</p>
    ) : (
      <ul class="event-list">
        {page.data.map((event) => (
          <EventCard event={event} as="li" />
        ))}
      </ul>
    )}
    {page.lastPage > 1 && (
      <nav aria-label="Pagination" class="pagination">
        {page.url.prev ? (
          <a href={page.url.prev}>‹ Prev</a>
        ) : (
          <span class="disabled">‹ Prev</span>
        )}
        <span>{page.currentPage} of {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next}>Next ›</a>
        ) : (
          <span class="disabled">Next ›</span>
        )}
      </nav>
    )}
  </Content>
</BaseLayout>

<style>
  .event-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem 0 0.25rem;
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
  }
  .pagination a {
    color: var(--accent-primary);
    text-decoration: none;
  }
  .pagination a:hover {
    text-decoration: underline;
  }
  .pagination .disabled {
    opacity: 0.4;
    pointer-events: none;
  }
</style>
