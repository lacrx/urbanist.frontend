---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero/Hero.astro";
import Content from "@/components/Content/Content.astro";
import Card from "@/components/Card/Card.astro";
import config from "@/site/config";
import { fetchDataPages } from "@/lib/strapi";

export const getStaticPaths = (async ({ paginate }) => {
  if (!config.build.dataPages) return paginate([], { pageSize: 5 });
  const dataPages = await fetchDataPages(config);
  return paginate(dataPages, { pageSize: 5 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout title="Data">
  <Hero title="Data" />
  <Content type="section" ruled>
    {page.data.length === 0 && <p>No data pages yet.</p>}
    {page.data.map((dp) => (
      <Card
        link={`/data/${dp.slug}`}
        title={dp.title}
        description={dp.description || ""}
        imageUrl={dp.coverUrl}
        cover={dp.cover}
        publishedAt={dp.dataUpdatedAt}
      />
    ))}
    {page.lastPage > 1 && (
      <nav aria-label="Pagination" class="pagination">
        {page.url.prev ? (
          <a href={page.url.prev}>‹ Prev</a>
        ) : (
          <span class="disabled">‹ Prev</span>
        )}
        <span>{page.currentPage} of {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next}>Next ›</a>
        ) : (
          <span class="disabled">Next ›</span>
        )}
      </nav>
    )}
  </Content>
</BaseLayout>

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem 0 0.25rem;
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
  }
  .pagination a {
    color: var(--accent-primary);
    text-decoration: none;
  }
  .pagination a:hover {
    text-decoration: underline;
  }
  .pagination .disabled {
    opacity: 0.4;
    pointer-events: none;
  }
</style>
