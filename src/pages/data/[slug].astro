---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero/Hero.astro";
import Content from "@/components/Content/Content.astro";
import ArticleBlocks from "@/components/ArticleBlocks/article-blocks";
import DashboardSkeleton from "@/components/Dashboard/DashboardSkeleton";
import { cover } from "@/components/ArticleBlocks/article-blocks.module.css";
import config from "@/site/config";
import { fetchDataPages, fetchVisualizations } from "@/lib/strapi";

export const getStaticPaths = (async () => {
  if (!config.build.dataPages) return [];
  const [dataPages, visualizations] = await Promise.all([
    fetchDataPages(config),
    fetchVisualizations(),
  ]);
  return dataPages.map((dp) => ({
    params: { slug: dp.slug },
    props: { dataPage: dp, visualizations },
  }));
}) satisfies GetStaticPaths;

const { dataPage, visualizations } = Astro.props;
const normalizedDashboardType = dataPage.dashboardType.replace(/_/g, "-");

const DATA_SECTION = { label: "Data", path: "/data" };
---

<BaseLayout
  title={dataPage.title}
  description={dataPage.description || undefined}
  breadcrumb={{ section: DATA_SECTION, title: dataPage.title }}
  bodyClass="article"
>
  <Hero
    title={dataPage.title}
    description={dataPage.description || undefined}
    style={{ "padding-bottom": "0" }}
  />
  <Content type="section">
    {dataPage.coverUrl && (
      <img src={dataPage.coverUrl} alt={dataPage.title} class={cover} loading="lazy" width="1050" height="600" />
    )}
    <ArticleBlocks client:visible blocks={dataPage.blocks} visualizations={visualizations} />
    <div id="dashboard-mount" data-type={normalizedDashboardType}>
      <DashboardSkeleton dashboardType={normalizedDashboardType} />
    </div>
    {dataPage.methodologyHtml && (
      <Content type="section" ruled>
        <div set:html={dataPage.methodologyHtml} />
      </Content>
    )}
  </Content>
</BaseLayout>

<script>
  import { lazy, Suspense, createElement } from "react";
  import { createRoot } from "react-dom/client";
  import DashboardSkeleton from "@/components/Dashboard/DashboardSkeleton";

  const DASHBOARDS: Record<string, React.LazyExoticComponent<React.ComponentType>> = {
    "permitted-units": lazy(() => import("@/components/Dashboard/PermittedUnitsDashboard")),
    "affordable-units": lazy(() => import("@/components/Dashboard/AffordableUnitsDashboard")),
    "affordability-map": lazy(() => import("@/components/Dashboard/AffordabilityDashboard")),
  };

  const mount = document.getElementById("dashboard-mount");
  if (mount) {
    const type = mount.dataset.type || "";
    const Dashboard = DASHBOARDS[type];
    if (Dashboard) {
      const root = createRoot(mount);
      root.render(
        createElement(
          Suspense,
          { fallback: createElement(DashboardSkeleton, { dashboardType: type }) },
          createElement(Dashboard),
        ),
      );
    }
  }
</script>
