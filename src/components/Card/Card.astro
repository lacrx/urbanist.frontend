---
import { Image } from "astro:assets";
import Byline from "@/components/Byline/Byline.astro";
import { card } from "./card.module.css";
import type { CoverImage } from "@/lib/strapi";

type Props = {
  link: string;
  title: string;
  description: string;
  imageUrl?: string | null;
  cover?: CoverImage | null;
  authorName?: string | null;
  publishedAt?: string | null;
};

const { link, title, description, imageUrl, cover, authorName, publishedAt } = Astro.props;
const thumbSrc = cover?.small ?? cover?.thumbnail ?? imageUrl;
---

<article class={card}>
  <div>
    <div><a href={link}><h2>{title}</h2></a></div>
    <div><a href={link}><p>{description}</p></a></div>
    <Byline author={authorName} publishedAt={publishedAt} compact />
  </div>
  {thumbSrc && (
    <div>
      <a href={link}>
        <Image src={thumbSrc} alt={title} width={150} height={150} loading="lazy" />
      </a>
    </div>
  )}
</article>
